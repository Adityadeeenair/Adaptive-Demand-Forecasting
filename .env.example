# .env.example
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored — never commit real credentials.

# ── Email Delivery (Recommended for Render: Resend HTTP API over Port 443) ───
# Render free tier blocks outbound SMTP ports (25, 465, 587).
# Get a free API key at https://resend.com (3,000 free emails/month).
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=ForecastIQ <onboarding@resend.dev>

# ── Alternative: Standard SMTP (Localhost / Unblocked VPS) ───────────────────
# Required only if RESEND_API_KEY is not set.
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password-here

# ── Session Cache (Optional) ─────────────────────────────────────────────────
# If unset, ForecastIQ runs seamlessly using its built-in in-memory store.
# Set only if using an external Redis instance (Upstash / Redis Cloud).
# REDIS_URL=redis://localhost:6379
